# Copy to .env (never commit .env).

# Path to YAML config (default: config/cradle.yaml)
# CRADLE_CONFIG=config/cradle.yaml

# Data directory (L1 diskcache, L2 Qdrant local, FastEmbed models)
# CRADLE_DATA_DIR=./data

# Proxy Bearer key. One key => one user_id (see config/cradle.yaml auth.keys).
CRADLE_API_KEY=

# Upstream OpenAI-compatible server (default in YAML: http://127.0.0.1:8080/v1)
# CRADLE_UPSTREAM_BASE_URL=http://127.0.0.1:8080/v1
CRADLE_UPSTREAM_API_KEY=

# Optional overlays
# CRADLE_PIPELINE_VERSION=v1
# CRADLE_SERVER__HOST=127.0.0.1
# CRADLE_SERVER__PORT=8000
# CRADLE_FEATURES__CACHE=true
# CRADLE_FEATURES__L2=true
# CRADLE_FEATURES__COMPRESSION=true
# CRADLE_FEATURES__STRUCTURE=false
# CRADLE_FEATURES__RECONSTRUCTION=true
# CRADLE_FEATURES__LOCAL_1B=false
# CRADLE_L2__COSINE_THRESHOLD=0.90
# CRADLE_CACHE__TTL_S=86400
# FASTEMBED_CACHE_PATH is set at startup to $CRADLE_DATA_DIR/models/fastembed
